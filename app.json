{
  "expo": {
    "name": "MeetOn",
    "slug": "meeton",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image",
      "expo-font",
      "expo-router",
      [
        "expo-contacts",
        {
          "contactsPermission": "MeetOn utilise vos contacts pour vous aider à inviter vos proches dans vos tribus."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MeetOn accède à vos photos pour votre photo de profil et celles de vos tribus."
        }
      ]
    ],
    "scheme": "meeton",
    "experiments": {
      "typedRoutes": true
    }
  }
}
